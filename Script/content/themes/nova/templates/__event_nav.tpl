<!-- event navigation -->
{if $event['event_privacy'] == 'public' || $event['i_joined'] || $event['i_admin'] || $user->_is_admin || $user->_is_moderator}
  {capture name="event_navigation"}
    {include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`" _icon="icon-[tabler--home]" _label=__("Timeline") _active=($view == '')}
    {include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/photos" _icon="icon-[tabler--photo]" _label=__("Photos") _active=in_array($view, ['photos','albums','album'])}
    {if $system['videos_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/videos" _icon="icon-[tabler--player-play]" _label=__("Videos") _active=($view == 'videos')}{/if}
    {if $system['reels_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/reels" _icon="icon-[tabler--movie]" _label=__("Reels") _active=($view == 'reels')}{/if}
    {include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/going" _icon="icon-[tabler--users]" _label=__("Going") _active=in_array($view, ['going','interested','invited'])}
    {include file='__profile_tab.tpl' _modal_url="users/search.php?type=event&id=`$event['event_id']`" _icon="icon-[tabler--search]" _label=__("Search") _active=($view == 'search')}
  {/capture}
  {capture name="event_more_navigation"}
    {if $system['blogs_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/blogs" _icon="icon-[tabler--article]" _label=__("Blogs") _active=($view == 'blogs')}{/if}
    {if $system['market_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/listings" _icon="icon-[tabler--building-store]" _label=__("Listings") _active=($view == 'listings')}{/if}
    {if $system['events_reviews_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/reviews" _icon="icon-[tabler--star]" _label=__("Reviews") _active=($view == 'reviews')}{/if}
    {include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/interested" _icon="icon-[tabler--star]" _label=__("Interested") _active=($view == 'interested')}
    {include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/invited" _icon="icon-[tabler--mail]" _label=__("Invited") _active=($view == 'invited')}
    {if $event['i_admin']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`/settings" _icon="icon-[tabler--settings]" _label=__("Settings") _active=($view == 'settings')}{/if}
  {/capture}
  <nav class="flex min-w-0 items-center gap-2 rounded-3xl bg-base-100 p-2 sm:gap-3 sm:p-3" aria-label='{__("Event sections")}'><div class="relative min-w-0 flex-1"><div class="overflow-x-auto overscroll-x-contain scroll-smooth snap-x snap-proximity scroll-px-1 [scrollbar-width:none]! [&::-webkit-scrollbar]:hidden!"><ul class="m-0 flex w-max min-w-full list-none items-center gap-1.5 py-1 ps-1 pe-6">{$smarty.capture.event_navigation nofilter}</ul></div><div class="pointer-events-none absolute inset-y-0 end-0 w-6 bg-linear-to-l from-base-100 to-transparent rtl:bg-linear-to-r" aria-hidden="true"></div></div>{if $smarty.capture.event_more_navigation|trim}<div class="shrink-0 border-s border-base-300 ps-2 sm:ps-3"><div class="dropdown relative inline-flex {if $system['language']['dir'] == 'RTL'}[--placement:bottom-start]{else}[--placement:bottom-end]{/if}"><button id="event-navigation-menu" type="button" class="dropdown-toggle heroui button button--tertiary h-12 gap-2 rounded-[1rem] border-0 px-3 shadow-none sm:px-4{if in_array($view, ['blogs','listings','reviews','settings'])} bg-primary/10 text-primary hover:bg-primary/15{/if}" aria-haspopup="true" aria-expanded="false" aria-controls="event-navigation-sections"><span class="icon-[tabler--layout-grid] size-5" aria-hidden="true"></span><span class="hidden sm:inline">{__("More")}</span><span class="icon-[tabler--chevron-down] size-4" aria-hidden="true"></span></button><div id="event-navigation-sections" class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-72 max-w-[calc(100vw-2rem)] rounded-3xl border border-base-300 p-2 shadow-lg" aria-labelledby="event-navigation-menu"><ul class="m-0 grid max-h-80 list-none gap-1 overflow-y-auto p-1 [&>li>a]:flex [&>li>a]:w-full [&>li>a]:justify-start [&>li>a]:whitespace-normal [&>li>a]:text-start">{$smarty.capture.event_more_navigation nofilter}</ul></div></div></div>{/if}</nav>
{else}
  <nav class="rounded-3xl bg-base-100 p-3" aria-label='{__("Event sections")}'><ul class="flex list-none gap-2">{include file='__profile_tab.tpl' _url="`$system['system_url']`/events/`$event['event_id']`" _icon="icon-[tabler--info-circle]" _label=__("About") _active=true}</ul></nav>
{/if}
