<!-- event header -->
<section class="rounded-3xl bg-base-100 pb-6" aria-labelledby="event-name">
  <div class="profile-cover-wrapper group/cover relative aspect-[3/1] overflow-hidden rounded-t-3xl bg-linear-to-br from-primary/35 via-primary/10 to-base-200 sm:aspect-[18/5] [&>img]:absolute [&>img]:start-0 [&>img]:top-0 [&>img]:w-full [&>.js\_position-cover-cropped]:h-full [&>.js\_position-cover-cropped]:object-cover [&>.js\_position-cover-full]:h-auto [&>.js\_position-cover-full]:cursor-move [&>.js\_position-cover-full]:touch-none [&>.js\_position-cover-full]:select-none">
    {if $event['event_cover_id']}
      <img class="js_position-cover-full hidden" src="{$event['event_cover_full']}" alt="">
      <img class="js_position-cover-cropped js_lightbox cursor-pointer" data-init-position="{$event['event_cover_position']}" data-id="{$event['event_cover_id']}" data-image="{$event['event_cover_full']}" data-context="album" src="{$event['event_cover']}" alt="{$event['event_title']}">
    {else}
      <span class="absolute inset-0 flex items-center justify-center text-primary/30"><span class="icon-[tabler--calendar-event] size-20" aria-hidden="true"></span></span>
    {/if}
    {if $event['i_admin']}
      <div class="absolute end-3 top-3 z-20 flex items-center gap-2 sm:end-5 sm:top-5">
        <div class="profile-cover-change dropdown relative inline-flex pointer-events-none opacity-0 transition-opacity group-hover/cover:pointer-events-auto group-hover/cover:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 dropdown-open:pointer-events-auto dropdown-open:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 [--placement:bottom-end] [--strategy:fixed]">
          <button type="button" id="event-cover-menu" class="dropdown-toggle heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm" aria-haspopup="menu" aria-expanded="false" aria-label='{__("Edit Cover")}'><span class="icon-[tabler--edit] size-4" aria-hidden="true"></span></button>
          <div class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-60 max-w-[calc(100vw-2rem)] rounded-2xl border border-base-300 bg-base-100 p-2 shadow-lg [&_.x-uploader]:relative [&_.x-uploader]:cursor-pointer [&_.x-uploader]:overflow-hidden [&_.x-uploader>input[type=file]]:absolute [&_.x-uploader>input[type=file]]:inset-0 [&_.x-uploader>input[type=file]]:z-10 [&_.x-uploader>input[type=file]]:size-full [&_.x-uploader>input[type=file]]:cursor-pointer [&_.x-uploader>input[type=file]]:opacity-0" aria-labelledby="event-cover-menu">
            <div class="dropdown-item flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium js_x-uploader" data-handle="cover-event" data-id="{$event['event_id']}"><span class="icon-[tabler--upload] size-5" aria-hidden="true"></span>{__("Upload Photo")}</div>
            <button type="button" class="js_modal dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium" data-url="users/photos.php?filter=cover&type=event&id={$event['event_id']}"><span class="icon-[tabler--photo] size-5" aria-hidden="true"></span>{__("Select Photo")}</button>
            <div class="profile-cover-position {if !$event['event_cover']}hidden{/if}"><input class="js_position-picture-val" type="hidden" name="position-picture-val"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium js_init-position-picture" data-handle="event" data-id="{$event['event_id']}"><span class="icon-[tabler--crop] size-5" aria-hidden="true"></span>{__("Reposition")}</button></div>
            <div class="profile-cover-delete border-t border-base-300 pt-1 {if !$event['event_cover']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium text-error! js_delete-cover" data-handle="cover-event" data-id="{$event['event_id']}"><span class="icon-[tabler--trash] size-5" aria-hidden="true"></span>{__("Delete")}</button></div>
          </div>
        </div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_save-position-picture" aria-label='{__("Save")}'><span class="icon-[tabler--check] size-4" aria-hidden="true"></span></button></div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_cancel-position-picture" aria-label='{__("Cancel")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>
      </div>
      <div class="profile-cover-change-loader absolute inset-0 z-30 hidden bg-base-100/80 px-8 pt-[12%]"><div class="progress x-progress h-2 w-full bg-base-300"><div class="progress-bar h-full rounded-full bg-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div></div>
      <div class="profile-cover-position-loader pointer-events-none absolute inset-x-3 bottom-3 z-10 hidden rounded-field bg-black/60 px-3 py-2 text-center text-xs text-white"><span class="icon-[tabler--arrows-move] me-1 inline-block size-4 align-middle" aria-hidden="true"></span>{__("Drag to reposition cover")}</div>
    {/if}
  </div>
  <div class="flex min-w-0 flex-col gap-5 px-4 pt-5 sm:px-6 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex min-w-0 gap-4 sm:gap-5">
      <time class="flex size-20 shrink-0 flex-col items-center justify-center rounded-2xl bg-primary/10 text-primary sm:size-24" datetime="{$event['event_start_date']|date_format:"%Y-%m-%dT%H:%M"}"><span class="text-xs font-bold uppercase tracking-wide">{__($event['event_start_date']|date_format:"%b")}</span><span class="text-3xl font-bold leading-none sm:text-4xl">{$event['event_start_date']|date_format:"%e"}</span><span class="text-xs">{$event['event_start_date']|date_format:"%Y"}</span></time>
      <div class="js_translate-wrapper min-w-0">
        <div class="flex flex-wrap gap-2 text-xs font-semibold"><span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{if $event['event_is_online']}{__("Online Event")}{else}{__("In Person")}{/if}</span><span class="rounded-full bg-base-200 px-3 py-1 text-base-content/70">{if $event['event_privacy'] == 'public'}{__("Public Event")}{elseif $event['event_privacy'] == 'closed'}{__("Closed Event")}{else}{__("Secret Event")}{/if}</span></div>
        <h1 id="event-name" class="mt-2 flex flex-wrap items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl"><a class="event-title-text min-w-0 text-base-content! [overflow-wrap:anywhere]" href="{$system['system_url']}/events/{$event['event_id']}">{$event['event_title']}</a>{if $system['post_translation_enabled']}<button type="button" class="js_translator js_translator-toggle text-base-content/60 hover:text-primary" data-node-type="event" data-node-id="{$event['event_id']}" data-source=".event-title-text" aria-label='{__("Translate")}'><span class="icon-[tabler--language] size-5" aria-hidden="true"></span></button>{/if}</h1>
        {if $event['event_privacy'] == 'public' || $event['i_joined'] || $event['i_admin'] || $user->_is_admin || $user->_is_moderator}<div class="mt-2 flex flex-wrap items-center gap-x-1.5 text-sm font-semibold text-base-content"><a class="link link-animated font-semibold! text-base-content!" href="{$system['system_url']}/events/{$event['event_id']}/going"><span class="tabular-nums">{abbreviate_count($event['event_going'])}</span> {__("Going")}</a><span class="text-base-content/40" aria-hidden="true">&middot;</span><a class="link link-animated font-semibold! text-base-content!" href="{$system['system_url']}/events/{$event['event_id']}/interested"><span class="tabular-nums">{abbreviate_count($event['event_interested'])}</span> {__("Interested")}</a><span class="text-base-content/40" aria-hidden="true">&middot;</span><a class="link link-animated font-semibold! text-base-content!" href="{$system['system_url']}/events/{$event['event_id']}/invited"><span class="tabular-nums">{abbreviate_count($event['event_invited'])}</span> {__("Invited")}</a></div>{/if}
        <ul class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content"><li class="flex basis-full min-w-0 items-center gap-1.5 max-sm:items-start"><span class="icon-[tabler--calendar-filled] size-4 shrink-0 max-sm:mt-0.5" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere] max-sm:flex max-sm:flex-col"><time datetime="{$event['event_start_date']|date_format:"%Y-%m-%dT%H:%M"}">{$event['event_start_date']|date_format:"%e"} {__($event['event_start_date']|date_format:"%b")} {$event['event_start_date']|date_format:"%I:%M %p"}</time> <span>{__("to")} <time datetime="{$event['event_end_date']|date_format:"%Y-%m-%dT%H:%M"}">{$event['event_end_date']|date_format:"%e"} {__($event['event_end_date']|date_format:"%b")} {$event['event_end_date']|date_format:"%I:%M %p"}</time></span></span></li>{if $event['event_privacy'] == 'public' || $event['i_joined'] || $event['i_admin'] || $user->_is_admin || $user->_is_moderator}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--user-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__("Hosted By")} <a class="link link-animated font-medium! text-base-content!" href="{$event['host_url']}">{$event['host_name']}</a></span></li><li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--map-pin-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{if $event['event_is_online']}{__("Online Event")}{elseif $event['event_location']}{$event['event_location']}{else}{__("In Person")}{/if}</span></li>{/if}</ul>
      </div>
    </div>
    <div class="profile-buttons-wrapper flex shrink-0 flex-wrap items-center gap-2 max-sm:w-full max-sm:flex-nowrap max-sm:[&>.js\_go-event]:flex-1 max-sm:[&>.js\_ungo-event]:flex-1 max-sm:[&>.js\_interest-event]:flex-1 max-sm:[&>.js\_uninterest-event]:flex-1">
      {if $event['event_privacy'] == 'public' || $event['i_joined'] || $event['i_admin']}
        {if $event['i_joined']['is_going']}
          {include file='__connection_button.tpl' _state="event_going" _id=$event['event_id'] _btn_size="md"}
        {else}
          {include file='__connection_button.tpl' _state="event_go" _id=$event['event_id'] _btn_size="md"}
        {/if}
        {if $event['i_joined']['is_interested']}
          {include file='__connection_button.tpl' _state="event_interested" _id=$event['event_id'] _btn_size="md"}
        {else}
          {include file='__connection_button.tpl' _state="event_interest" _id=$event['event_id'] _btn_size="md"}
        {/if}
      {/if}
      {if $system['events_reviews_enabled'] && !$event['i_admin']}<button type="button" class="js_modal heroui button button--tertiary rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem] max-sm:size-10 max-sm:shrink-0 max-sm:px-0!" data-url="modules/review.php?do=review&id={$event['event_id']}&type=event" title='{__("Review")}'><span class="icon-[tabler--star] size-4" aria-hidden="true"></span><span class="max-sm:sr-only">{__("Review")}</span></button>{/if}
      {include file='__entity_actions_menu.tpl' _can_invite=$event['i_joined'] _invite_description=__("Invite your friends to this event") _node_type='event' _node_id=$event['event_id'] _node_username=$event['event_id'] _node_admin=$event['i_admin'] _node_boosted=$event['event_boosted'] _can_boost=$user->_data['can_boost_events'] _share_description=__("Share this event") _boost_description=__("Boost Event") _admin_url="`$system['system_url']`/admincp/events/edit_event/`$event['event_id']`" _moderator_url="`$system['system_url']`/modcp/events/edit_event/`$event['event_id']`"}
    </div>
  </div>
</section>
<!-- event header -->
