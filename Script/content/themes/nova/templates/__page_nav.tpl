{capture name="page_navigation"}
  {include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`" _icon="icon-[tabler--home]" _label=__("Timeline") _active=($view == "")}
  {include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/photos" _icon="icon-[tabler--photo]" _label=__("Photos") _active=in_array($view, ["photos", "albums", "album"])}
  {if $system['videos_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/videos" _icon="icon-[tabler--player-play]" _label=__("Videos") _active=($view == "videos")}{/if}
  {if $system['reels_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/reels" _icon="icon-[tabler--movie]" _label=__("Reels") _active=($view == "reels")}{/if}
  {include file='__profile_tab.tpl' _modal_url="users/search.php?type=page&id=`$spage['page_id']`" _icon="icon-[tabler--search]" _label=__("Search") _active=($view == "search")}
{/capture}
{capture name="page_more_navigation"}
  {if $system['blogs_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/blogs" _icon="icon-[tabler--article]" _label=__("Blogs") _active=($view == "blogs")}{/if}
  {if $system['market_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/listings" _icon="icon-[tabler--building-store]" _label=__("Listings") _active=($view == "listings")}{/if}
  {if $system['pages_reviews_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/reviews" _icon="icon-[tabler--star]" _label=__("Reviews") _active=($view == "reviews")}{/if}
  {if $system['events_enabled'] && $system['pages_events_enabled']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/events" _icon="icon-[tabler--calendar-event]" _label=__("Events") _active=($view == "events")}{/if}
  {if $spage['has_subscriptions_plans']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/subscribers" _icon="icon-[tabler--users]" _label=__("Subscribers") _active=($view == "subscribers")}{/if}
  {if $spage['i_admin']}{include file='__profile_tab.tpl' _url="`$system['system_url']`/pages/`$spage['page_name']`/settings" _icon="icon-[tabler--settings]" _label=__("Settings") _active=($view == "settings")}{/if}
{/capture}
