msgstr "Το δωρεάν token πρόσβασης IPinfo Lite από το"

#: content/themes/nova/templates/admin.settings.security.tpl:120
msgid "New Location Login Alerts"
msgstr "Ειδοποιήσεις σύνδεσης από νέα τοποθεσία"

#: content/themes/nova/templates/admin.settings.security.tpl:122
msgid ""
"Send the user an email and a notification when their account is logged in "
"from a new country (requires IPinfo)"
msgstr ""
"Αποστολή email και ειδοποίησης στον χρήστη όταν γίνεται σύνδεση στον "
"λογαριασμό του από νέα χώρα (απαιτεί IPinfo)"

#: content/themes/nova/templates/admin.settings.security.tpl:132
msgid "Two-factor authentication"
msgstr "Έλεγχος ταυτότητας δύο παραγόντων"

#: content/themes/nova/templates/admin.settings.security.tpl:142
msgid ""
"Enable two-factor authentication to log in with a code from your email/phone "
"as well as a password"
msgstr ""
"Ενεργοποίηση του ελέγχου ταυτότητας δύο παραγόντων, ώστε η σύνδεση να "
