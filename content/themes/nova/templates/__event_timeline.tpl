<!-- event timeline -->
<div class="grid min-w-0 items-start gap-6 lg:grid-cols-[23rem_minmax(0,1fr)]{if $system['chat_enabled'] && $event['chatbox_enabled']} xl:grid-cols-[18rem_minmax(0,1fr)_18rem]{/if}">
  <aside class="min-w-0"><div class="accordion"><div class="accordion-item" id="event-details"><button type="button" id="event-details-toggle" class="accordion-toggle flex w-full items-center justify-between rounded-3xl bg-base-100 px-4 py-3 text-sm font-medium lg:hidden" aria-controls="event-details-content" aria-expanded="false"><span class="flex items-center gap-2"><span class="icon-[tabler--info-circle] size-5 text-base-content/60" aria-hidden="true"></span>{__("About")}</span><span class="icon-[tabler--chevron-down] size-4 accordion-item-active:rotate-180" aria-hidden="true"></span></button><div id="event-details-content" class="accordion-content hidden overflow-hidden transition-[height] duration-300 motion-reduce:transition-none lg:block! lg:h-auto! lg:overflow-visible" role="region" aria-label='{__("About")}'><div class="pt-5 lg:pt-0">{include file='__event_details.tpl'}</div></div></div></div></aside>
  <div class="min-w-0 space-y-5">
    {if $user->_data['user_group'] < 3 && ($event['event_privacy'] == 'secret' || $event['event_privacy'] == 'closed') && !$event['i_joined'] && !$event['i_admin']}<div class="alert alert-warning flex items-center gap-3 rounded-2xl" role="status"><span class="icon-[tabler--info-circle] size-5 shrink-0" aria-hidden="true"></span><span class="min-w-0 flex-1 text-sm">{__("You can access this as your account is system admin account!")}</span><button type="button" class="js_dismiss-alert heroui button button--ghost button--sm button--icon-only size-6 rounded-full" aria-label='{__("Close")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>{/if}
    {if $get == 'posts_event'}
      {if $event['pending_posts'] > 0}<div class="alert alert-info flex items-center gap-3 rounded-2xl" role="status"><span class="icon-[tabler--messages] size-5 shrink-0" aria-hidden="true"></span><a class="min-w-0 flex-1 text-sm font-medium text-inherit!" href="?pending">{if $event['i_admin']}<span class="badge badge-info me-1">{$event['pending_posts']}</span>{if $event['pending_posts'] == 1}{__("post")}{else}{__("posts")}{/if} {__("pending needs your approval")}{else}{__("You have")} <span class="badge badge-info mx-1">{$event['pending_posts']}</span>{if $event['pending_posts'] == 1}{__("post")}{else}{__("posts")}{/if} {__("pending")}{/if}</a><button type="button" class="js_dismiss-alert heroui button button--ghost button--sm button--icon-only size-6 rounded-full" aria-label='{__("Close")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>{/if}
      {if $event['i_joined'] && ($event['event_publish_enabled'] || (!$event['event_publish_enabled'] && $event['i_admin']))}{if $event['event_page'] && $event['i_admin']}{include file='__publisher_trigger.tpl' _handle='event' _id=$event['event_id'] _name=$event['event_page']['page_title'] _avatar=$event['event_page']['page_picture'] _target=$event['event_title']}{else}{include file='__publisher_trigger.tpl' _handle='event' _id=$event['event_id'] _name=$user->_data['user_fullname'] _avatar=$user->_data['user_picture'] _target=$event['event_title']}{/if}{/if}
      {if $pinned_post}{include file='_pinned_post.tpl' post=$pinned_post _get='posts_event'}{/if}
      {include file='_posts.tpl' _get='posts_event' _id=$event['event_id']}
    {else}
      {include file='_posts.tpl' _get=$get _id=$event['event_id'] _title=__("Pending Posts")}
    {/if}
  </div>
  {if $system['chat_enabled'] && $event['chatbox_enabled']}<aside class="min-w-0">{include file='_chatbox.tpl' _node_type='event' _node=$event}</aside>{/if}
</div>
<!-- event timeline -->
