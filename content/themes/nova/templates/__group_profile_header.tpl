<!-- group header -->
<section class="rounded-3xl bg-base-100 pb-5 sm:pb-6" aria-labelledby="group-name">
  <div class="profile-cover-wrapper group/cover relative aspect-[3/1] overflow-hidden rounded-t-3xl bg-linear-to-br from-primary/35 via-primary/10 to-base-200 sm:aspect-[18/5] [&>img]:absolute [&>img]:start-0 [&>img]:top-0 [&>img]:w-full [&>.js\_position-cover-cropped]:h-full [&>.js\_position-cover-cropped]:object-cover [&>.js\_position-cover-full]:h-auto [&>.js\_position-cover-full]:cursor-move [&>.js\_position-cover-full]:touch-none [&>.js\_position-cover-full]:select-none">
    {if $group['group_cover_id']}
      <img class="js_position-cover-full hidden" src="{$group['group_cover_full']}" alt="">
      <img class="js_position-cover-cropped js_lightbox cursor-pointer" data-init-position="{$group['group_cover_position']}" data-id="{$group['group_cover_id']}" data-image="{$group['group_cover_full']}" data-context="album" src="{$group['group_cover']}" alt="{$group['group_title']}">
    {/if}
    {if $group['i_admin']}
      <div class="absolute end-3 top-3 z-20 flex items-center gap-2 sm:end-5 sm:top-5">
        <div class="profile-cover-change dropdown relative inline-flex pointer-events-none opacity-0 transition-opacity group-hover/cover:pointer-events-auto group-hover/cover:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 dropdown-open:pointer-events-auto dropdown-open:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 [--placement:bottom-end] [--strategy:fixed]">
          <button type="button" id="group-cover-menu" class="dropdown-toggle heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm" aria-haspopup="menu" aria-expanded="false" aria-label='{__("Edit Cover")}'><span class="icon-[tabler--edit] size-4" aria-hidden="true"></span></button>
          <div class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-60 max-w-[calc(100vw-2rem)] rounded-2xl border border-base-300 bg-base-100 p-2 shadow-lg [&_.x-uploader]:relative [&_.x-uploader]:cursor-pointer [&_.x-uploader]:overflow-hidden [&_.x-uploader>input[type=file]]:absolute [&_.x-uploader>input[type=file]]:inset-0 [&_.x-uploader>input[type=file]]:z-10 [&_.x-uploader>input[type=file]]:size-full [&_.x-uploader>input[type=file]]:cursor-pointer [&_.x-uploader>input[type=file]]:opacity-0" aria-labelledby="group-cover-menu">
            <div class="dropdown-item flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium js_x-uploader" data-handle="cover-group" data-id="{$group['group_id']}"><span class="icon-[tabler--upload] size-5" aria-hidden="true"></span>{__("Upload Photo")}</div>
            <button type="button" class="js_modal dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium" data-url="users/photos.php?filter=cover&type=group&id={$group['group_id']}"><span class="icon-[tabler--photo] size-5" aria-hidden="true"></span>{__("Select Photo")}</button>
            <div class="profile-cover-position {if !$group['group_cover']}hidden{/if}"><input class="js_position-picture-val" type="hidden" name="position-picture-val"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium js_init-position-picture" data-handle="group" data-id="{$group['group_id']}"><span class="icon-[tabler--crop] size-5" aria-hidden="true"></span>{__("Reposition")}</button></div>
            <div class="profile-cover-delete border-t border-base-300 pt-1 {if !$group['group_cover']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium text-error! js_delete-cover" data-handle="cover-group" data-id="{$group['group_id']}"><span class="icon-[tabler--trash] size-5" aria-hidden="true"></span>{__("Delete")}</button></div>
          </div>
        </div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_save-position-picture" aria-label='{__("Save")}'><span class="icon-[tabler--check] size-4" aria-hidden="true"></span></button></div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_cancel-position-picture" aria-label='{__("Cancel")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>
      </div>
      <div class="profile-cover-change-loader absolute inset-0 z-30 hidden bg-base-100/80 px-8 pt-[12%]"><div class="progress x-progress h-2 w-full bg-base-300"><div class="progress-bar h-full rounded-full bg-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div></div>
      <div class="profile-cover-position-loader pointer-events-none absolute inset-x-3 bottom-3 z-10 hidden rounded-field bg-black/60 px-3 py-2 text-center text-xs text-white"><span class="icon-[tabler--arrows-move] me-1 inline-block size-4 align-middle" aria-hidden="true"></span>{__("Drag to reposition cover")}</div>
    {/if}
  </div>
  <div class="grid min-w-0 gap-5 px-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-8 sm:px-6 xl:grid-cols-[13rem_minmax(0,1fr)]">
    <div class="profile-avatar-wrapper group/avatar relative z-10 -mt-12 size-32 shrink-0 rounded-3xl corner-squircle supports-[corner-shape:squircle]:rounded-[3rem] bg-base-200 ring-8 ring-base-100 sm:-mt-16 sm:size-40 xl:-mt-20 xl:size-52 [&>img]:size-full [&>img]:rounded-[inherit] [&>img]:corner-squircle [&>img]:object-cover">
      <img {if $group['group_picture_id']}class="js_lightbox cursor-pointer" data-id="{$group['group_picture_id']}" data-image="{$group['group_picture_full']}" data-context="album"{elseif !$group['group_picture_default']}class="js_lightbox-nodata cursor-pointer" data-image="{$group['group_picture']}"{/if} src="{$group['group_picture']}" alt="{$group['group_title']}">
      {if $group['i_admin']}
        <div class="absolute end-2 bottom-2 z-20 sm:end-3 sm:bottom-3">
          <div class="profile-avatar-change dropdown relative inline-flex pointer-events-none opacity-0 transition-opacity group-hover/avatar:pointer-events-auto group-hover/avatar:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 dropdown-open:pointer-events-auto dropdown-open:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 [--placement:bottom-start] [--strategy:fixed]">
            <button type="button" id="group-avatar-menu" class="dropdown-toggle heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm" aria-haspopup="menu" aria-expanded="false" aria-label='{__("Edit Picture")}'><span class="icon-[tabler--edit] size-4" aria-hidden="true"></span></button>
            <div class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-60 max-w-[calc(100vw-2rem)] rounded-2xl border border-base-300 bg-base-100 p-2 shadow-lg [&_.x-uploader]:relative [&_.x-uploader]:cursor-pointer [&_.x-uploader]:overflow-hidden [&_.x-uploader>input[type=file]]:absolute [&_.x-uploader>input[type=file]]:inset-0 [&_.x-uploader>input[type=file]]:z-10 [&_.x-uploader>input[type=file]]:size-full [&_.x-uploader>input[type=file]]:cursor-pointer [&_.x-uploader>input[type=file]]:opacity-0" aria-labelledby="group-avatar-menu">
              <div class="dropdown-item flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium js_x-uploader" data-handle="picture-group" data-id="{$group['group_id']}"><span class="icon-[tabler--upload] size-5" aria-hidden="true"></span>{__("Upload Photo")}</div>
              <button type="button" class="js_modal dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium" data-url="users/photos.php?filter=avatar&type=group&id={$group['group_id']}"><span class="icon-[tabler--photo] size-5" aria-hidden="true"></span>{__("Select Photo")}</button>
              <div class="profile-avatar-crop {if $group['group_picture_default']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium js_init-crop-picture" data-image="{$group['group_picture_full']}" data-handle="group" data-id="{$group['group_id']}"><span class="icon-[tabler--crop] size-5" aria-hidden="true"></span>{__("Crop")}</button></div>
              <div class="profile-avatar-delete border-t border-base-300 pt-1 {if $group['group_picture_default']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium text-error! js_delete-picture" data-handle="picture-group" data-id="{$group['group_id']}"><span class="icon-[tabler--trash] size-5" aria-hidden="true"></span>{__("Delete")}</button></div>
            </div>
          </div>
        </div>
        <div class="profile-avatar-change-loader absolute inset-0 z-30 hidden rounded-[inherit] bg-base-100/80 px-3 pt-[45%]"><div class="progress x-progress h-2 w-full bg-base-300"><div class="progress-bar h-full rounded-full bg-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div></div>
      {/if}
    </div>
    <div class="min-w-0 sm:pt-6 xl:grid xl:grid-cols-[minmax(0,1fr)_auto] xl:gap-x-6">
      <div class="js_translate-wrapper min-w-0">
        <h1 id="group-name" class="inline-flex flex-wrap items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl"><a class="group-title-text min-w-0 text-base-content! [overflow-wrap:anywhere]" href="{$system['system_url']}/groups/{$group['group_name']}">{$group['group_title']}</a>{if $group['group_privacy'] == 'public'}<span class="icon-[tabler--world] size-5 text-base-content/60" role="img" aria-label='{__("Public Group")}'></span>{elseif $group['group_privacy'] == 'closed'}<span class="icon-[tabler--lock-open] size-5 text-base-content/60" role="img" aria-label='{__("Closed Group")}'></span>{else}<span class="icon-[tabler--lock] size-5 text-base-content/60" role="img" aria-label='{__("Secret Group")}'></span>{/if}{if $system['post_translation_enabled']}<button type="button" class="js_translator js_translator-toggle text-base-content/60 hover:text-primary" data-node-type="group" data-node-id="{$group['group_id']}" data-source=".group-title-text" aria-label='{__("Translate")}'><span class="icon-[tabler--language] size-5" aria-hidden="true"></span></button>{/if}</h1>
        <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-base-content/60"><span class="break-all" dir="auto">@{$group['group_name']}</span></div>
      </div>
      <div class="mt-2 flex xl:col-span-2 flex-wrap items-center gap-x-1.5 text-sm font-semibold text-base-content"><a class="link link-animated font-semibold! text-base-content!" href="{$system['system_url']}/groups/{$group['group_name']}/members"><span class="tabular-nums">{abbreviate_count($group['group_members'])}</span> {__("members")}</a>{if $system['groups_reviews_enabled'] && $group['group_rate']}<span class="text-base-content/40" aria-hidden="true">&middot;</span><a class="link link-animated font-semibold! text-base-content! inline-flex items-center gap-1" href="{$system['system_url']}/groups/{$group['group_name']}/reviews"><span class="icon-[tabler--star-filled] size-4 text-warning" aria-hidden="true"></span>{$group['group_rate']|number_format:1} {__("Reviews")}</a>{/if}</div>
      <ul class="mt-2 flex xl:col-span-2 flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content">{if $group['group_privacy'] == 'public'}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--world] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__("Public Group")}</span></li>{elseif $group['group_privacy'] == 'closed'}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--lock-open] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__("Closed Group")}</span></li>{else}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--lock-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__("Secret Group")}</span></li>{/if}{if $group['group_category_name']}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--tag-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__($group['group_category_name'])}</span></li>{/if}</ul>
      <div class="profile-buttons-wrapper mt-5 flex w-full flex-wrap items-center gap-2 max-sm:[&>.js\_join-group]:flex-1 max-sm:[&>.js\_leave-group]:flex-1 xl:col-start-2 xl:row-start-1 xl:mt-0 xl:w-auto xl:justify-end xl:self-center">
        {if $group['i_joined'] == 'approved'}
          {include file='__connection_button.tpl' _state="group_joined" _id=$group['group_id'] _privacy=$group['group_privacy'] _btn_size="md"}
        {elseif $group['i_joined'] == 'pending'}
          {include file='__connection_button.tpl' _state="group_pending" _id=$group['group_id'] _privacy=$group['group_privacy'] _btn_size="md"}
        {elseif $group['i_admin']}
          {include file='__connection_button.tpl' _state="group_join" _id=$group['group_id'] _privacy="public" _btn_size="md"}
        {else}
          {include file='__connection_button.tpl' _state="group_join" _id=$group['group_id'] _privacy=$group['group_privacy'] _btn_size="md"}
        {/if}
        {if $system['groups_reviews_enabled'] && !$group['i_admin']}<button type="button" class="js_modal heroui button button--tertiary rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem]" data-url="modules/review.php?do=review&id={$group['group_id']}&type=group"><span class="icon-[tabler--star] size-4" aria-hidden="true"></span>{__("Review")}</button>{/if}
        {include file='__entity_actions_menu.tpl' _can_invite=($group['i_joined'] == 'approved') _invite_description=__("Invite your friends to join this group") _node_type='group' _node_id=$group['group_id'] _node_username=$group['group_name'] _node_admin=$group['i_admin'] _node_boosted=$group['group_boosted'] _can_boost=$user->_data['can_boost_groups'] _share_description=__("Share this group") _boost_description=__("Boost Group") _admin_url="`$system['system_url']`/admincp/groups/edit_group/`$group['group_id']`" _moderator_url="`$system['system_url']`/modcp/groups/edit_group/`$group['group_id']`"}
      </div>
      {if $user->_logged_in && !$group['i_admin'] && (($group['has_subscriptions_plans']))}
        <div class="mt-4 flex flex-wrap xl:col-span-2 items-center gap-2 border-t border-base-300 pt-4">
          {if $group['has_subscriptions_plans']}<button type="button" class="js_modal heroui button button--primary h-auto min-h-10 max-w-full rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem] py-2 whitespace-normal" data-url="monetization/controller.php?do=get_plans&node_id={$group['group_id']}&node_type=group" data-size="large"><span class="icon-[tabler--crown] size-4" aria-hidden="true"></span>{__("SUBSCRIBE FOR")} {if $group['group_monetization_discount_enabled']}{print_money($group['group_monetization_min_price'] * (1 - $group['group_monetization_discount_percent'] / 100))} <s class="opacity-70">{print_money($group['group_monetization_min_price'])}</s>{else}{print_money($group['group_monetization_min_price'])}{/if}</button>{/if}
        </div>
      {/if}
    </div>
  </div>
</section>
<!-- group header -->
