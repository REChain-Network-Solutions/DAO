<!-- group timeline -->
<div class="grid min-w-0 items-start gap-6 lg:grid-cols-[23rem_minmax(0,1fr)]{if $system['chat_enabled'] && $group['chatbox_enabled']} xl:grid-cols-[18rem_minmax(0,1fr)_18rem]{/if}">
  <aside class="min-w-0"><div class="accordion"><div class="accordion-item" id="group-details"><button type="button" id="group-details-toggle" class="accordion-toggle flex w-full items-center justify-between rounded-3xl bg-base-100 px-4 py-3 text-sm font-medium lg:hidden" aria-controls="group-details-content" aria-expanded="false"><span class="flex items-center gap-2"><span class="icon-[tabler--info-circle] size-5 text-base-content/60" aria-hidden="true"></span>{__("About")}</span><span class="icon-[tabler--chevron-down] size-4 accordion-item-active:rotate-180" aria-hidden="true"></span></button><div id="group-details-content" class="accordion-content hidden overflow-hidden transition-[height] duration-300 motion-reduce:transition-none lg:block! lg:h-auto! lg:overflow-visible" role="region" aria-label='{__("About")}'><div class="pt-5 lg:pt-0">{include file='__group_details.tpl'}</div></div></div></div></aside>
  <div class="min-w-0 space-y-5">
    {if $user->_data['user_group'] < 3 && ($group['group_privacy'] == 'secret' || $group['group_privacy'] == 'closed') && $group['i_joined'] != 'approved' && !$group['i_admin']}<div class="alert alert-warning flex items-center gap-3 rounded-2xl" role="status"><span class="icon-[tabler--info-circle] size-5 shrink-0" aria-hidden="true"></span><span class="min-w-0 flex-1 text-sm">{__("You can access this as your account is system admin account!")}</span><button type="button" class="js_dismiss-alert heroui button button--ghost button--sm button--icon-only size-6 rounded-full" aria-label='{__("Close")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>{/if}
    {if $get == 'posts_group'}
      {if $group['i_admin'] && $group['total_requests'] > 0}<div class="alert alert-info flex items-center gap-3 rounded-2xl" role="status"><span class="icon-[tabler--users] size-5 shrink-0" aria-hidden="true"></span><a class="min-w-0 flex-1 text-sm font-medium text-inherit!" href="{$system['system_url']}/groups/{$group['group_name']}/settings/requests"><span class="badge badge-info me-1">{$group['total_requests']}</span>{if $group['total_requests'] == 1}{__("person")}{else}{__("persons")}{/if} {__("wants to join this group")}</a><button type="button" class="js_dismiss-alert heroui button button--ghost button--sm button--icon-only size-6 rounded-full" aria-label='{__("Close")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>{/if}
      {if !empty($group['pending_posts'])}<div class="alert alert-info flex items-center gap-3 rounded-2xl" role="status"><span class="icon-[tabler--messages] size-5 shrink-0" aria-hidden="true"></span><a class="min-w-0 flex-1 text-sm font-medium text-inherit!" href="?pending">{if $group['i_admin']}<span class="badge badge-info me-1">{$group['pending_posts']}</span>{if $group['pending_posts'] == 1}{__("post")}{else}{__("posts")}{/if} {__("pending needs your approval")}{else}{__("You have")} <span class="badge badge-info mx-1">{$group['pending_posts']}</span>{if $group['pending_posts'] == 1}{__("post")}{else}{__("posts")}{/if} {__("pending")}{/if}</a><button type="button" class="js_dismiss-alert heroui button button--ghost button--sm button--icon-only size-6 rounded-full" aria-label='{__("Close")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>{/if}
      {if $group['i_joined'] == 'approved' && ($group['group_publish_enabled'] || (!$group['group_publish_enabled'] && $group['i_admin']))}{include file='__publisher_trigger.tpl' _handle='group' _id=$group['group_id'] _name=$user->_data['user_fullname'] _avatar=$user->_data['user_picture'] _target=$group['group_title']}{/if}
      {if $pinned_post}{include file='_pinned_post.tpl' post=$pinned_post _get='posts_group'}{/if}
      {include file='_posts.tpl' _get='posts_group' _id=$group['group_id']}
    {else}
      {include file='_posts.tpl' _get=$get _id=$group['group_id'] _title=__("Pending Posts")}
    {/if}
  </div>
  {if $system['chat_enabled'] && $group['chatbox_enabled']}<aside class="min-w-0">{include file='_chatbox.tpl' _node_type='group' _node=$group}</aside>{/if}
</div>
<!-- group timeline -->
