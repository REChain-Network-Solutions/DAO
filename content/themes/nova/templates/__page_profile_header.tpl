<!-- page header -->
<section class="rounded-3xl bg-base-100 pb-5 sm:pb-6" aria-labelledby="page-name">
  <div class="profile-cover-wrapper group/cover relative aspect-[3/1] overflow-hidden rounded-t-3xl bg-linear-to-br from-primary/35 via-primary/10 to-base-200 sm:aspect-[18/5] [&>img]:absolute [&>img]:start-0 [&>img]:top-0 [&>img]:w-full [&>.js\_position-cover-cropped]:h-full [&>.js\_position-cover-cropped]:object-cover [&>.js\_position-cover-full]:h-auto [&>.js\_position-cover-full]:cursor-move [&>.js\_position-cover-full]:touch-none [&>.js\_position-cover-full]:select-none">
    {if $spage['page_cover_id']}
      <img class="js_position-cover-full hidden" src="{$spage['page_cover_full']}" alt="">
      <img class="js_position-cover-cropped js_lightbox cursor-pointer" data-init-position="{$spage['page_cover_position']}" data-id="{$spage['page_cover_id']}" data-image="{$spage['page_cover_full']}" data-context="album" src="{$spage['page_cover']}" alt="{$spage['page_title']}">
    {/if}
    {if $spage['i_admin']}
      <div class="absolute end-3 top-3 z-20 flex items-center gap-2 sm:end-5 sm:top-5">
        <div class="profile-cover-change dropdown relative inline-flex pointer-events-none opacity-0 transition-opacity group-hover/cover:pointer-events-auto group-hover/cover:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 dropdown-open:pointer-events-auto dropdown-open:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 [--placement:bottom-end] [--strategy:fixed]">
          <button type="button" id="page-cover-menu" class="dropdown-toggle heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm" aria-haspopup="menu" aria-expanded="false" aria-label='{__("Edit Cover")}'><span class="icon-[tabler--edit] size-4" aria-hidden="true"></span></button>
          <div class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-60 max-w-[calc(100vw-2rem)] rounded-2xl border border-base-300 bg-base-100 p-2 shadow-lg [&_.x-uploader]:relative [&_.x-uploader]:cursor-pointer [&_.x-uploader]:overflow-hidden [&_.x-uploader>input[type=file]]:absolute [&_.x-uploader>input[type=file]]:inset-0 [&_.x-uploader>input[type=file]]:z-10 [&_.x-uploader>input[type=file]]:size-full [&_.x-uploader>input[type=file]]:cursor-pointer [&_.x-uploader>input[type=file]]:opacity-0" aria-labelledby="page-cover-menu">
            <div class="dropdown-item flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium js_x-uploader" data-handle="cover-page" data-id="{$spage['page_id']}"><span class="icon-[tabler--upload] size-5" aria-hidden="true"></span>{__("Upload Photo")}</div>
            <button type="button" class="js_modal dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium" data-url="users/photos.php?filter=cover&type=page&id={$spage['page_id']}"><span class="icon-[tabler--photo] size-5" aria-hidden="true"></span>{__("Select Photo")}</button>
            <div class="profile-cover-position {if !$spage['page_cover']}hidden{/if}"><input class="js_position-picture-val" type="hidden" name="position-picture-val"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium js_init-position-picture" data-handle="page" data-id="{$spage['page_id']}"><span class="icon-[tabler--crop] size-5" aria-hidden="true"></span>{__("Reposition")}</button></div>
            <div class="profile-cover-delete border-t border-base-300 pt-1 {if !$spage['page_cover']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium text-error! js_delete-cover" data-handle="cover-page" data-id="{$spage['page_id']}"><span class="icon-[tabler--trash] size-5" aria-hidden="true"></span>{__("Delete")}</button></div>
          </div>
        </div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_save-position-picture" aria-label='{__("Save")}'><span class="icon-[tabler--check] size-4" aria-hidden="true"></span></button></div>
        <div class="profile-cover-position-buttons hidden"><button type="button" class="heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm js_cancel-position-picture" aria-label='{__("Cancel")}'><span class="icon-[tabler--x] size-4" aria-hidden="true"></span></button></div>
      </div>
      <div class="profile-cover-change-loader absolute inset-0 z-30 hidden bg-base-100/80 px-8 pt-[12%]"><div class="progress x-progress h-2 w-full bg-base-300"><div class="progress-bar h-full rounded-full bg-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div></div>
      <div class="profile-cover-position-loader pointer-events-none absolute inset-x-3 bottom-3 z-10 hidden rounded-field bg-black/60 px-3 py-2 text-center text-xs text-white"><span class="icon-[tabler--arrows-move] me-1 inline-block size-4 align-middle" aria-hidden="true"></span>{__("Drag to reposition cover")}</div>
    {/if}
  </div>
  <div class="grid min-w-0 gap-5 px-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-8 sm:px-6 xl:grid-cols-[13rem_minmax(0,1fr)]">
    <div class="profile-avatar-wrapper group/avatar relative z-10 -mt-12 size-32 shrink-0 rounded-3xl corner-squircle supports-[corner-shape:squircle]:rounded-[3rem] bg-base-200 ring-8 ring-base-100 sm:-mt-16 sm:size-40 xl:-mt-20 xl:size-52 [&>img]:size-full [&>img]:rounded-[inherit] [&>img]:corner-squircle [&>img]:object-cover">
      <img {if !$spage['page_picture_default']}class="js_lightbox cursor-pointer" data-id="{$spage['page_picture_id']}" data-image="{$spage['page_picture_full']}" data-context="album"{/if} src="{$spage['page_picture']}" alt="{$spage['page_title']}">
      {if $spage['i_admin']}
        <div class="absolute end-2 bottom-2 z-20 sm:end-3 sm:bottom-3">
          <div class="profile-avatar-change dropdown relative inline-flex pointer-events-none opacity-0 transition-opacity group-hover/avatar:pointer-events-auto group-hover/avatar:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 dropdown-open:pointer-events-auto dropdown-open:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 [--placement:bottom-start] [--strategy:fixed]">
            <button type="button" id="page-avatar-menu" class="dropdown-toggle heroui button button--tertiary button--sm button--icon-only size-7.5 rounded-full border-transparent bg-base-100 text-base-content shadow-sm" aria-haspopup="menu" aria-expanded="false" aria-label='{__("Edit Picture")}'><span class="icon-[tabler--edit] size-4" aria-hidden="true"></span></button>
            <div class="dropdown-menu dropdown-open:opacity-100 z-50 hidden w-60 max-w-[calc(100vw-2rem)] rounded-2xl border border-base-300 bg-base-100 p-2 shadow-lg [&_.x-uploader]:relative [&_.x-uploader]:cursor-pointer [&_.x-uploader]:overflow-hidden [&_.x-uploader>input[type=file]]:absolute [&_.x-uploader>input[type=file]]:inset-0 [&_.x-uploader>input[type=file]]:z-10 [&_.x-uploader>input[type=file]]:size-full [&_.x-uploader>input[type=file]]:cursor-pointer [&_.x-uploader>input[type=file]]:opacity-0" aria-labelledby="page-avatar-menu">
              <div class="dropdown-item flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium js_x-uploader" data-handle="picture-page" data-id="{$spage['page_id']}"><span class="icon-[tabler--upload] size-5" aria-hidden="true"></span>{__("Upload Photo")}</div>
              <button type="button" class="js_modal dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium" data-url="users/photos.php?filter=avatar&type=page&id={$spage['page_id']}"><span class="icon-[tabler--photo] size-5" aria-hidden="true"></span>{__("Select Photo")}</button>
              <div class="profile-avatar-crop {if $spage['page_picture_default']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium js_init-crop-picture" data-image="{$spage['page_picture_full']}" data-handle="page" data-id="{$spage['page_id']}"><span class="icon-[tabler--crop] size-5" aria-hidden="true"></span>{__("Crop")}</button></div>
              <div class="profile-avatar-delete border-t border-base-300 pt-1 {if $spage['page_picture_default']}hidden{/if}"><button type="button" class="dropdown-close dropdown-item flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-sm font-medium text-error! js_delete-picture" data-handle="picture-page" data-id="{$spage['page_id']}"><span class="icon-[tabler--trash] size-5" aria-hidden="true"></span>{__("Delete")}</button></div>
            </div>
          </div>
        </div>
        <div class="profile-avatar-change-loader absolute inset-0 z-30 hidden rounded-[inherit] bg-base-100/80 px-3 pt-[45%]"><div class="progress x-progress h-2 w-full bg-base-300"><div class="progress-bar h-full rounded-full bg-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div></div></div>
      {/if}
    </div>
    <div class="min-w-0 sm:pt-6 xl:grid xl:grid-cols-[minmax(0,1fr)_auto] xl:gap-x-6">
      <div class="js_translate-wrapper min-w-0">
        <h1 id="page-name" class="inline-flex flex-wrap items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl"><a class="page-title-text min-w-0 text-base-content! [overflow-wrap:anywhere]" href="{$system['system_url']}/pages/{$spage['page_name']}">{$spage['page_title']}</a>{if $spage['page_verified']}{include file='__badge.tpl' _badge="verified" _badge_type="page" _badge_size=20}{/if}{if $system['post_translation_enabled']}<button type="button" class="js_translator js_translator-toggle text-base-content/60 hover:text-primary" data-node-type="page" data-node-id="{$spage['page_id']}" data-source=".page-title-text" aria-label='{__("Translate")}'><span class="icon-[tabler--language] size-5" aria-hidden="true"></span></button>{/if}</h1>
        <div class="mt-1 flex flex-col items-start gap-0.5 text-sm text-base-content/60"><span class="break-all" dir="auto">@{$spage['page_name']}</span>{if $system['pages_pbid_enabled'] && $spage['page_pbid']}<span class="tabular-nums">{__("PBID")} {$spage['page_pbid']}</span>{/if}</div>
      </div>
      <div class="mt-2 flex xl:col-span-2 flex-wrap items-center gap-x-1.5 text-sm font-semibold text-base-content"><span><span class="tabular-nums">{abbreviate_count($spage['page_likes'])}</span> {__("likes")}</span>{if $system['pages_reviews_enabled'] && $spage['page_rate']}<span class="text-base-content/40" aria-hidden="true">&middot;</span><a class="link link-animated font-semibold! text-base-content! inline-flex items-center gap-1" href="{$system['system_url']}/pages/{$spage['page_name']}/reviews"><span class="icon-[tabler--star-filled] size-4 text-warning" aria-hidden="true"></span>{$spage['page_rate']|number_format:1} {__("Reviews")}</a>{/if}</div>
      <ul class="mt-2 flex xl:col-span-2 flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content">{if $spage['page_category_name']}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--tag-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{__($spage['page_category_name'])}</span></li>{/if}{if $spage['page_company']}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--briefcase-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{$spage['page_company']}</span></li>{/if}{if $spage['page_location']}<li class="inline-flex min-w-0 items-center gap-1.5"><span class="icon-[tabler--map-pin-filled] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{$spage['page_location']}</span></li>{/if}{if $spage['page_website']}<li class="flex basis-full min-w-0 items-center gap-1.5"><span class="icon-[tabler--link] size-4 shrink-0" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]"><a class="link link-animated font-normal! text-base-content!" target="_blank" rel="nofollow noopener" href="{$spage['page_website']}">{$spage['page_website']|regex_replace:"#^https?://(www\.)?#i":""|regex_replace:"#/$#":""}</a></span></li>{/if}</ul>
      <div class="profile-buttons-wrapper mt-5 flex w-full flex-wrap items-center gap-2 max-sm:[&>.js\_like-page]:flex-1 max-sm:[&>.js\_unlike-page]:flex-1 xl:col-start-2 xl:row-start-1 xl:mt-0 xl:w-auto xl:justify-end xl:self-center">
        {if $spage['i_like']}
          {include file='__connection_button.tpl' _state="page_liked" _id=$spage['page_id'] _btn_size="md"}
        {else}
          {include file='__connection_button.tpl' _state="page_like" _id=$spage['page_id'] _btn_size="md"}
        {/if}
        {if $spage['page_action_text'] && $spage['page_action_url']}<a target="_blank" rel="nofollow noopener" href="{$spage['page_action_url']}" class="heroui button rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem] {if $spage['page_action_color'] == 'danger'}button--danger{elseif $spage['page_action_color'] == 'light'}button--tertiary{elseif $spage['page_action_color'] == 'success'}button--primary [--button-bg:var(--success)] [--button-bg-hover:var(--success-hover)] [--button-bg-pressed:var(--success-hover)] [--button-fg:var(--success-foreground)]{elseif $spage['page_action_color'] == 'info'}button--primary [--button-bg:var(--color-info)] [--button-bg-hover:color-mix(in_oklab,var(--color-info)_90%,black)] [--button-bg-pressed:color-mix(in_oklab,var(--color-info)_90%,black)] [--button-fg:var(--color-info-content)]{elseif $spage['page_action_color'] == 'warning'}button--primary [--button-bg:var(--warning)] [--button-bg-hover:var(--warning-hover)] [--button-bg-pressed:var(--warning-hover)] [--button-fg:var(--warning-foreground)]{else}button--primary{/if}">{$spage['page_action_text']}</a>{/if}
        {if $user->_logged_in && $spage['can_receive_messages'] && !$spage['i_admin']}<button type="button" class="js_chat-start heroui button button--tertiary rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem]" data-page-id="{$spage['page_id']}" data-name="{$spage['page_title']}" data-link="pages/{$spage['page_name']}" data-picture="{$spage['page_picture']}"><span class="icon-[tabler--message-circle] size-4" aria-hidden="true"></span>{__("Message")}</button>{/if}
        {if $system['pages_reviews_enabled'] && !$spage['i_admin']}<button type="button" class="js_modal heroui button button--tertiary rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem]" data-url="modules/review.php?do=review&id={$spage['page_id']}&type=page"><span class="icon-[tabler--star] size-4" aria-hidden="true"></span>{__("Review")}</button>{/if}
        {include file='__entity_actions_menu.tpl' _can_invite=$spage['i_like'] _invite_description=__("Invite your friends to like this page") _node_type='page' _node_id=$spage['page_id'] _node_username=$spage['page_name'] _node_admin=$spage['i_admin'] _node_boosted=$spage['page_boosted'] _can_boost=$user->_data['can_boost_pages'] _share_description=__("Share this page") _boost_description=__("Boost Page") _admin_url="`$system['system_url']`/admincp/pages/edit_page/`$spage['page_id']`" _moderator_url="`$system['system_url']`/modcp/pages/edit_page/`$spage['page_id']`"}
      </div>
      {if $user->_logged_in && !$spage['i_admin'] && (($spage['has_subscriptions_plans']) || ($spage['can_receive_tips'] && $spage['page_tips_enabled']))}
        <div class="mt-4 flex flex-wrap xl:col-span-2 items-center gap-2 border-t border-base-300 pt-4">
          {if $spage['has_subscriptions_plans']}<button type="button" class="js_modal heroui button button--primary h-auto min-h-10 max-w-full rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem] py-2 whitespace-normal" data-url="monetization/controller.php?do=get_plans&node_id={$spage['page_id']}&node_type=page" data-size="large"><span class="icon-[tabler--crown] size-4" aria-hidden="true"></span>{__("SUBSCRIBE FOR")} {if $spage['page_monetization_discount_enabled']}{print_money($spage['page_monetization_min_price'] * (1 - $spage['page_monetization_discount_percent'] / 100))} <s class="opacity-70">{print_money($spage['page_monetization_min_price'])}</s>{else}{print_money($spage['page_monetization_min_price'])}{/if}</button>{/if}
          {if $spage['can_receive_tips'] && $spage['page_tips_enabled']}<button type="button" class="js_modal heroui button button--tertiary rounded-[0.625rem] corner-squircle supports-[corner-shape:squircle]:rounded-[1rem] group relative overflow-visible border-0 pe-16 bg-linear-to-r from-orange-500 to-rose-500 text-white hover:brightness-105" data-url="#send-tip" data-options='{ "id": "{$spage['page_admin']}"}'><img class="pointer-events-none absolute -top-1.5 end-3 size-10 -rotate-12 drop-shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6 rtl:rotate-12" src="{$system['system_url']}/content/themes/{$system['theme']}/images/svg/buttons/coin.svg" alt="" aria-hidden="true">{__("Send a Tip")}</button>{/if}
        </div>
      {/if}
    </div>
  </div>
</section>
